<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExamenJulianZ.Views.resumenPage"
             Title="Resumen">

    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="10">

            <Label Text="RESUMEN"
                   FontSize="24"
                   HorizontalOptions="Center"/>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*">

                <Label Text="Usuario:" Grid.Row="0"/>
                <Label x:Name="lblUsuario" Grid.Row="0" Grid.Column="1"/>

                <Label Text="Nombre:" Grid.Row="1"/>
                <Label x:Name="lblNombre" Grid.Row="1" Grid.Column="1"/>

                <Label Text="Apellido:" Grid.Row="2"/>
                <Label x:Name="lblApellido" Grid.Row="2" Grid.Column="1"/>

                <Label Text="Edad:" Grid.Row="3"/>
                <Label x:Name="lblEdad" Grid.Row="3" Grid.Column="1"/>

                <Label Text="Fecha:" Grid.Row="4"/>
                <Label x:Name="lblFecha" Grid.Row="4" Grid.Column="1"/>

                <Label Text="País:" Grid.Row="5"/>
                <Label x:Name="lblPais" Grid.Row="5" Grid.Column="1"/>

                <Label Text="Ciudad:" Grid.Row="6"/>
                <Label x:Name="lblCiudad" Grid.Row="6" Grid.Column="1"/>

                <Label Text="Monto Inicial:" Grid.Row="7"/>
                <Label x:Name="lblMontoInicial" Grid.Row="7" Grid.Column="1"/>

                <Label Text="Pago Mensual:" Grid.Row="8"/>
                <Label x:Name="lblPagoMensual" Grid.Row="8" Grid.Column="1"/>

            </Grid>

            <Label Text="Pago Total:"
                   FontAttributes="Bold"/>

            <Label x:Name="lblPagoTotal"
                   FontSize="20"
                   TextColor="Green"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>